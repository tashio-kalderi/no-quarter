<section class="tab attributes {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#if isMonsterAbility}}
  {{!-- A monster ability is rolled against the monster's own Stats line. --}}
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="resource-label">Damage type</label>
      <select name="system.damageType">
        {{selectOptions config.damageTypes selected=system.damageType localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Range</label>
      <input type="text" name="system.range" value="{{system.range}}" placeholder="30 ft."/>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Reg/Great/Ext</label>
      <span class="ability-chances">
        <span class="chance">{{chances.regular}}</span>/<span class="chance">{{chances.greater}}</span>/<span class="chance">{{chances.extreme}}</span>
      </span>
    </div>
  </div>
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="resource-label">Uses per combat</label>
      <input type="text" name="system.uses" value="{{system.uses}}" data-dtype="Number"/>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Attacks per use</label>
      <input type="text" name="system.attacks" value="{{system.attacks}}" data-dtype="Number"/>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Damage per hit</label>
      <input type="text" name="system.damage" value="{{system.damage}}" data-dtype="Number"/>
    </div>
  </div>
  <div class="resource">
    <label class="resource-label">Effect</label>
    <input type="text" name="system.effect" value="{{system.effect}}"/>
  </div>
  {{else}}
  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label">Action Type</label>
      <select name="system.actionType" {{#if (or system.basicKey buildLocked)}}disabled{{/if}}>
        {{selectOptions actionTypeChoices selected=system.actionType localize=true}}
      </select>
      {{!-- Only supplemental abilities can be Special. --}}
      {{#if (eq system.actionType "supplemental")}}
      <label class="checkbox ability-special" data-tooltip="{{localize 'NOQUARTER.ActionType.special.hint'}}">
        <input type="checkbox" name="system.special" {{checked system.special}} {{#if buildLocked}}disabled{{/if}}/>
        {{localize 'NOQUARTER.ActionType.special.label'}}
      </label>
      {{/if}}
    </div>
    <div class="grid-span-1 ability-stats">
      {{!-- Rank can't go above the highest of these; a full action rolls with the highest. --}}
      <label class="resource-label">Stats</label>
      {{formInput statsField value=statsValue type="checkboxes" choices=config.stats localize=true disabled=(or system.basicKey buildLocked)}}
    </div>
  </div>
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="resource-label">Min Rank</label>
      <input type="text" name="system.minRank" value="{{system.minRank}}" data-dtype="Number" {{#if buildLocked}}disabled{{/if}}
             data-tooltip="Taking the ability costs this many ability points."/>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Max Rank</label>
      <input type="text" name="system.maxRank" value="{{system.maxRank}}" data-dtype="Number" {{#if buildLocked}}disabled{{/if}}/>
    </div>
    <div class="grid-span-1"></div>
  </div>
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="resource-label">Rank</label>
      <input type="text" name="system.rank" value="{{system.rank}}" data-dtype="Number" {{#if buildLocked}}disabled{{/if}}/>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Stamina Cost</label>
      <input type="text" name="system.staminaCost" value="{{system.staminaCost}}" data-dtype="Number"/>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">Reg/Great/Ext</label>
      <span class="ability-chances">
        {{#if chances}}<span class="chance">{{chances.regular}}</span>/<span class="chance">{{chances.greater}}</span>/<span class="chance">{{chances.extreme}}</span>{{else}}{{localize (lookup (lookup config.actionTypes system.actionType) "label")}}{{/if}}
      </span>
    </div>
  </div>
  {{#unless system.basicKey}}
    <div class="resource ability-basic-attacks">
      {{!-- The basic attacks this ability works with. --}}
      <label class="resource-label">{{localize 'NOQUARTER.BasicAttack.label'}}</label>
      {{formInput basicAttacksField value=basicAttacksValue type="checkboxes" choices=config.basicAttacks localize=true disabled=buildLocked}}
    </div>
    {{!-- The number in the effect that grows with rank; see NoQuarterAbility#scaledValue. --}}
    <div class="grid grid-3col">
      <div class="grid-span-1">
        <label class="resource-label" data-tooltip="{{localize 'NOQUARTER.Scaling.baseHint'}}">{{localize 'NOQUARTER.Scaling.base'}}</label>
        <input type="text" name="system.scaling.base" value="{{system.scaling.base}}" data-dtype="Number"/>
      </div>
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'NOQUARTER.Scaling.step'}}</label>
        <input type="text" name="system.scaling.step" value="{{system.scaling.step}}" data-dtype="Number"/>
      </div>
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'NOQUARTER.Scaling.mode'}}</label>
        <select name="system.scaling.mode">
          {{selectOptions config.scalingModes selected=system.scaling.mode localize=true}}
        </select>
      </div>
    </div>
    {{!-- An ability such as Impose Condition asks for its condition when a character takes it. --}}
    <div class="grid grid-2col">
      <div class="grid-span-1">
        <label class="checkbox" data-tooltip="{{localize 'NOQUARTER.ImposeCondition.ChoiceHint'}}">
          <input type="checkbox" name="system.conditionChoice" {{checked system.conditionChoice}} {{#if buildLocked}}disabled{{/if}}/>
          {{localize 'NOQUARTER.ImposeCondition.ChoiceLabel'}}
        </label>
      </div>
      {{#if system.conditionChoice}}
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'NOQUARTER.ImposeCondition.Condition'}}</label>
        <select name="system.condition" {{#if buildLocked}}disabled{{/if}}>
          {{selectOptions conditionChoices selected=system.condition blank="-"}}
        </select>
      </div>
      {{/if}}
    </div>
    <div class="grid grid-2col">
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'NOQUARTER.Automation.label'}}</label>
        <select name="system.automation">
          {{selectOptions automationChoices selected=system.automation localize=true}}
        </select>
      </div>
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'NOQUARTER.Scaling.currentLabel'}}</label>
        <span class="ability-scaled">{{#if system.scaledLabel}}{{system.scaledLabel}}{{else}}-{{/if}}</span>
      </div>
    </div>
  {{/unless}}
  {{#if system.basicKey}}
    <div class="resource">
      <label class="resource-label">Damage (base 1)</label>
      {{!-- Shown with bonuses from abilities such as Increase Damage; saved without them. --}}
      <input type="text" name="system.damage" value="{{system.totalDamage}}" data-dtype="Number"
             {{#unless isGM}}disabled{{/unless}}
             {{#if system.damageTooltip}}data-tooltip="{{system.damageTooltip}}"{{/if}}/>
    </div>
  {{else}}
    <div class="resource">
      <label class="resource-label">Effect/Notes</label>
      <input type="text" name="system.effect" value="{{system.effect}}"/>
    </div>
  {{/if}}
  {{/if}}
</section>
