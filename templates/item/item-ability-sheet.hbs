<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Name"/></h1>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributes">Attributes</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Attributes Tab --}}
    <div class="tab attributes" data-group="primary" data-tab="attributes">
      {{#if isMonsterAbility}}
      {{!-- A monster ability is rolled against the monster's own Stats line. --}}
      <div class="grid grid-4col">
        <div class="grid-span-1">
          <label class="resource-label">Damage type</label>
          <select name="system.damageType">
            {{selectOptions config.damageTypes selected=system.damageType localize=true blank="-"}}
          </select>
        </div>
        <div class="grid-span-1">
          <label class="resource-label">Range</label>
          <input type="text" name="system.range" value="{{system.range}}" placeholder="30 ft."/>
        </div>
        <div class="grid-span-1">
          <label class="resource-label">Uses per combat</label>
          <input type="text" name="system.uses" value="{{system.uses}}" data-dtype="Number"/>
        </div>
        <div class="grid-span-1">
          <label class="resource-label">Reg/Great/Ext</label>
          <span class="ability-chances">
            <span class="chance">{{chances.regular}}</span>/<span class="chance">{{chances.greater}}</span>/<span class="chance">{{chances.extreme}}</span>
          </span>
        </div>
      </div>
      <div class="resource">
        <label class="resource-label">Damage/Effect</label>
        <input type="text" name="system.effect" value="{{system.effect}}"/>
      </div>
      {{else}}
      <div class="grid grid-4col">
        <div class="grid-span-1">
          <label class="resource-label">Stat</label>
          <select name="system.stat" {{#if system.basicKey}}disabled{{/if}}>
            {{selectOptions config.stats selected=system.stat localize=true blank="-"}}
          </select>
        </div>
        <div class="grid-span-1">
          <label class="resource-label">Rank</label>
          <input type="text" name="system.rank" value="{{system.rank}}" data-dtype="Number"/>
        </div>
        <div class="grid-span-1">
          <label class="resource-label">Stamina Cost</label>
          <input type="text" name="system.staminaCost" value="{{system.staminaCost}}" data-dtype="Number"/>
        </div>
        <div class="grid-span-1">
          <label class="resource-label">Reg/Great/Ext</label>
          <span class="ability-chances">
            {{#if chances}}<span class="chance">{{chances.regular}}</span>/<span class="chance">{{chances.greater}}</span>/<span class="chance">{{chances.extreme}}</span>{{else}}{{localize 'NOQUARTER.Passive'}}{{/if}}
          </span>
        </div>
      </div>
      {{#if system.basicKey}}
        <div class="resource">
          <label class="resource-label">Damage (base 1)</label>
          <input type="text" name="system.damage" value="{{system.damage}}" data-dtype="Number"/>
        </div>
      {{else}}
        <div class="resource">
          <label class="resource-label">Effect/Notes</label>
          <input type="text" name="system.effect" value="{{system.effect}}"/>
        </div>
      {{/if}}
      {{/if}}
    </div>

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedDescription target="system.description" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
      {{> "systems/no-quarter/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>

</form>
