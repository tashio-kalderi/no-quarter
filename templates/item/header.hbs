<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"/>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Name"/></h1>
    {{#if (eq item.type "item")}}
      <div class="grid grid-2col">
        <div class="resource">
          <label class="resource-label">Quantity</label>
          <input type="text" name="system.quantity" value="{{system.quantity}}" data-dtype="Number"/>
        </div>
        <div class="resource">
          <label class="resource-label">Weight</label>
          <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="Number"/>
        </div>
      </div>
    {{/if}}
    {{#if (eq item.type "boon")}}
      <div class="grid grid-2col">
        <div class="resource">
          <label class="resource-label" title="{{localize 'NOQUARTER.Boon.MinLevelHint'}}">{{localize 'NOQUARTER.Boon.MinLevel'}}</label>
          <input type="number" name="system.minLevel" value="{{system.minLevel}}" min="1" step="1"/>
        </div>
        <div class="resource">
          <label class="resource-label" title="{{localize 'NOQUARTER.Boon.GrantsWoundsHint'}}">{{localize 'NOQUARTER.Boon.GrantsWounds'}}</label>
          <input type="checkbox" name="system.grantsWounds" {{checked system.grantsWounds}}/>
        </div>
        <div class="resource">
          <label class="resource-label" title="{{localize 'NOQUARTER.Boon.GrantsAdvantageHint'}}">{{localize 'NOQUARTER.Boon.GrantsAdvantage'}}</label>
          <input type="checkbox" name="system.grantsAdvantage" {{checked system.grantsAdvantage}}/>
        </div>
      </div>
    {{/if}}
  </div>
</header>
