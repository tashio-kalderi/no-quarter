{{!-- An application part must render a single root element. --}}
<div class="turn-tracker">
{{!-- Whose turn it is, or the GM's declaration of who attacks first --}}
{{#if started}}
<div class="turn-banner {{#if awaitingDeclaration}}undeclared{{/if}}">
    {{#if awaitingDeclaration}}
    {{#if isGM}}
    <span>{{ localize "NOQUARTER.Turn.WhoFirst" }}</span>
    <span class="turn-declare">
        {{#each groups}}
        <button type="button" class="turn-declare-button" data-action="declareSide" data-side="{{ side }}">
            {{ localize "NOQUARTER.Turn.Attack" side=label }}
        </button>
        {{/each}}
    </span>
    {{else}}
    <span>{{ localize "NOQUARTER.Turn.WaitingForGM" }}</span>
    {{/if}}
    {{else}}
    <span>{{ banner }}</span>
    {{/if}}
</div>
{{/if}}

{{#each groups}}
<section class="turn-group {{ side }} {{#if current}}current{{/if}}">
    <h3 class="turn-group-header">
        <span class="turn-group-name">{{ label }}</span>
        {{#if current}}<span class="turn-group-up">{{ localize "NOQUARTER.Turn.Up" }}</span>{{/if}}
        {{#if canGive}}
        <button type="button" class="turn-group-give inline-control" data-action="declareSide" data-side="{{ side }}"
                data-tooltip aria-label="{{ localize "NOQUARTER.Turn.GiveTurn" side=label }}">
            <i class="fa-solid fa-arrow-right" inert></i>
        </button>
        {{/if}}
    </h3>

    <ol class="combat-tracker plain">
        {{#each turns}}
        <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
            {{!-- Image --}}
            <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

            {{!-- Name & Controls --}}
            <div class="token-name">
                <strong class="name">{{ name }}</strong>
                <div class="combatant-controls">
                    {{#if @root.user.isGM}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                            data-action="toggleHidden" data-tooltip aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide") }}"></button>
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                            data-action="toggleDefeated" data-tooltip
                            aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated") }}"></button>
                    {{/if}}
                    {{#if canPing}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                            data-action="pingCombatant" data-tooltip
                            aria-label="{{ localize "COMBATANT.Ping" }}"></button>
                    {{/if}}
                    {{#unless @root.user.isGM}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                            data-action="panToCombatant" data-tooltip
                            aria-label="{{ localize "COMBATANT.PanTo" }}"></button>
                    {{/unless}}
                    <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
                        {{#each effects.icons}}
                        <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                        {{/each}}
                    </div>
                </div>
            </div>

            {{!-- Resource --}}
            {{#if resource includeZero=true}}
            <div class="token-resource">
                <span class="resource">{{ resource }}</span>
            </div>
            {{/if}}

            {{!-- Turn --}}
            <div class="turn-controls">
                {{#if showStart}}
                <button type="button" class="turn-control turn-start" data-action="startTurn"
                        {{#if startBlocked}}disabled{{/if}} data-tooltip="{{ startTooltip }}" aria-label="{{ startTooltip }}">
                    <i class="fa-solid fa-play" inert></i>
                </button>
                {{/if}}
                {{#if showEnd}}
                <button type="button" class="turn-control turn-end" data-action="endTurn"
                        data-tooltip aria-label="{{ localize "NOQUARTER.Turn.End" }}">
                    <i class="fa-solid fa-check" inert></i>
                </button>
                <button type="button" class="turn-control turn-cancel" data-action="cancelTurn"
                        data-tooltip aria-label="{{ localize "NOQUARTER.Turn.Cancel" }}">
                    <i class="fa-solid fa-xmark" inert></i>
                </button>
                {{/if}}
                {{#if showMarkDone}}
                <button type="button" class="turn-control turn-mark-done" data-action="markDone"
                        data-tooltip aria-label="{{ localize "NOQUARTER.Turn.MarkDone" }}">
                    <i class="fa-solid fa-forward" inert></i>
                </button>
                {{/if}}
                {{#if showDone}}
                <span class="turn-done" data-tooltip aria-label="{{ localize "NOQUARTER.Turn.Done" }}">
                    <i class="fa-solid fa-circle-check" inert></i>
                </span>
                {{/if}}
                {{#if showReopen}}
                <button type="button" class="turn-control turn-reopen" data-action="reopenTurn"
                        data-tooltip aria-label="{{ localize "NOQUARTER.Turn.Reopen" }}">
                    <i class="fa-solid fa-rotate-left" inert></i>
                </button>
                {{/if}}
            </div>
        </li>
        {{/each}}
    </ol>
</section>
{{/each}}
</div>
