<section class="tab skills-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{!-- Racial skills and skills are only added or removed in build mode (or by the GM).
  Racial skills are dragged in from the compendium; dropping one anywhere on the sheet puts
  it here. Their Health, Stamina, Speed and vision bonuses apply automatically. --}}
  <div class="racial-skills">
    <h3>{{localize 'NOQUARTER.RacialSkill.Title'}}
      <span class="racial-skills-count">{{racialSkills.length}}/{{config.maxRacialSkills}}</span>
    </h3>
    <ol class="racial-skills-list">
      {{#each racialSkills as |skill|}}
      <li class="racial-skill draggable" data-item-id="{{skill._id}}">
        <img src="{{skill.img}}" title="{{skill.name}}" width="24" height="24"/>
        <span class="racial-skill-name">{{skill.name}}{{#if skill.choice}}
          <span class="racial-skill-choice">({{skill.choice}})</span>{{/if}}</span>
        <span class="racial-skill-summary">{{skill.summary}}</span>
        <div class="item-controls">
          <a class="item-control" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Item'}}">
            <i class="fas fa-edit"></i>
          </a>
          {{#if @root.build.canEdit}}
          <a class="item-control" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Item'}}">
            <i class="fas fa-trash"></i>
          </a>
          {{/if}}
        </div>
      </li>
      {{else}}
      <li class="racial-skills-empty">{{localize 'NOQUARTER.RacialSkill.Empty'}}</li>
      {{/each}}
    </ol>
  </div>

  <div class="profession">
    <h3>{{localize 'NOQUARTER.Profession.Title'}}</h3>
    <div class="profession-fields">
      <input type="text" name="system.profession.name" value="{{system.profession.name}}"
             placeholder="{{localize 'NOQUARTER.Profession.Name'}}"/>
      <input type="text" name="system.profession.description" value="{{system.profession.description}}"
             placeholder="{{localize 'NOQUARTER.Profession.Description'}}"/>
    </div>
  </div>

  {{!-- Skills are items: dragged in from the compendium, or added with + and named here. Rows
  have no name attribute; the sheet saves the name to the skill item (_onSkillNameChange). --}}
  <div class="skills">
    <h3 class="skills-title">{{localize 'NOQUARTER.Tabs.skills'}}
      {{#if @root.build.canEdit}}
      <a class="item-control" data-action="createItem" data-type="skill" title="{{localize 'NOQUARTER.Skill.Create'}}">
        <i class="fas fa-plus"></i>
      </a>
      {{/if}}
    </h3>
    <ol class="skills-list">
      {{#each skills as |skill|}}
      <li class="skill-row draggable" data-item-id="{{skill._id}}">
        <input type="text" class="skill-field" data-field="name" value="{{skill.name}}"
               {{#unless @root.editable}}disabled{{/unless}}/>
        <div class="item-controls">
          <a class="item-control" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Item'}}">
            <i class="fas fa-edit"></i>
          </a>
          {{#if @root.build.canEdit}}
          <a class="item-control" data-action="deleteItem" title="{{localize 'NOQUARTER.Skill.Delete'}}">
            <i class="fas fa-trash"></i>
          </a>
          {{/if}}
        </div>
      </li>
      {{else}}
      <li class="skills-empty">{{localize 'NOQUARTER.Skill.Empty'}}</li>
      {{/each}}
    </ol>
  </div>
</section>
