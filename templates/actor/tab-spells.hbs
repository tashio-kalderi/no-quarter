<section class="tab spells {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <ol class="items-list">
    {{#each spells as |spells spellLevel|}}
      <li class="item flexrow items-header">
        <div class="item-name">
          {{localize 'NOQUARTER.Item.Spell.SpellLVL' level=spellLevel}}
        </div>
        <div class="item-controls">
          <a class="item-control" data-action="createItem" data-type="spell" data-spell-level="{{spellLevel}}"
             title="{{localize 'DOCUMENT.Create' type='Spell'}}">
            <i class="fas fa-plus"></i>
            {{localize 'NOQUARTER.Item.Spell.AddLVL' level=spellLevel}}
          </a>
        </div>
      </li>
      {{#each spells as |item|}}
        <li class="item flexrow draggable" data-item-id="{{item._id}}">
          <div class="item-name flexrow">
            <div class="item-image">
              <a class="rollable" data-action="roll" data-roll-type="item">
                <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
              </a>
            </div>
            <h4>{{item.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control" data-action="editItem" title="{{localize 'DOCUMENT.Edit' type='spell'}}">
              <i class="fas fa-edit"></i>
            </a>
            <a class="item-control" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='spell'}}">
              <i class="fas fa-trash"></i>
            </a>
          </div>
        </li>
      {{/each}}
    {{/each}}
  </ol>
</section>
