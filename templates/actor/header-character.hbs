<header class="sheet-header">
  <div class="profile">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" height="100" width="100"/>
    {{#if inCombat}}
    <a class="breather disabled" data-tooltip="{{ localize "NOQUARTER.Breather.InCombat" }}">
    {{else}}
    <a class="breather" data-action="breather" data-tooltip="{{ localize "NOQUARTER.Breather.Hint" }}">
    {{/if}}
      <img src="systems/no-quarter/assets/icons/breather.png" alt="{{ localize "NOQUARTER.Breather.Label" }}" width="24" height="24"/>
    </a>
  </div>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
    {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
    use both the "grid" and "grid-Ncol" class where "N" can be any number
    from 1 to 12 and will create that number of columns.  --}}
    <div class="resources grid grid-4col">

      {{!-- "flex-group-center" is also defined in the _grid.scss file
      and it will add a small amount of padding, a border, and will
      center all of its child elements content and text. --}}
      <div class="resource flex-group-center">
        <label for="system.race" class="resource-label">Race</label>
        <input type="text" name="system.race" value="{{system.race}}"/>
      </div>

      <div class="resource flex-group-center">
        <label for="system.gender" class="resource-label">Gender</label>
        <input type="text" name="system.gender" value="{{system.gender}}"/>
      </div>

      <div class="resource flex-group-center">
        <label for="system.alignment" class="resource-label">Alignment</label>
        <input type="text" name="system.alignment" value="{{system.alignment}}"/>
      </div>

      <div class="resource flex-group-center">
        <label for="system.attributes.level.value" class="resource-label">Level</label>
        <div class="resource-content flexrow flex-center flex-between">
        {{!-- Raising the level enters build mode. Players can't change it while the GM has locked building. --}}
        <input type="text" name="system.attributes.level.value" value="{{system.attributes.level.value}}" data-dtype="Number"
               {{#if build.levelLocked}}disabled data-tooltip="{{localize 'NOQUARTER.Build.LevelLocked'}}"{{/if}}/>
        {{#if build.canEnter}}
        <a class="build-enter" data-action="enterBuild" data-tooltip="{{localize 'NOQUARTER.Build.EnterHint'}}"
           aria-label="{{localize 'NOQUARTER.Build.Enter'}}"><i class="fa-solid fa-hammer"></i></a>
        {{/if}}
        </div>
      </div>

    </div>
  </div>
  {{!-- Points left to spend, shown only while the character is being built or levelled up. --}}
  {{#if build.building}}
  {{#with build.progression as |p|}}
  <div class="build-tracker">
    <span class="build-title"><i class="fa-solid fa-hammer"></i> {{localize 'NOQUARTER.Build.Building'}}</span>
    <span class="build-pool {{#if (lt p.stats.remaining 0)}}overspent{{/if}}">
      {{localize 'NOQUARTER.Build.StatsLeft'}}: <strong>{{p.stats.remaining}}</strong> / {{p.stats.earned}}
    </span>
    <span class="build-pool {{#if (lt p.abilities.remaining 0)}}overspent{{/if}}">
      {{localize 'NOQUARTER.Build.AbilitiesLeft'}}: <strong>{{p.abilities.remaining}}</strong> / {{p.abilities.earned}}
    </span>
    <span class="build-pool {{#if (lt p.skills.remaining 0)}}overspent{{/if}}">
      {{localize 'NOQUARTER.Build.SkillsLeft'}}: <strong>{{p.skills.remaining}}</strong> / {{p.skills.earned}}
    </span>
    <span class="build-pool">{{localize 'NOQUARTER.Build.StatCapLabel'}}: <strong>{{p.statCap}}</strong></span>
    {{#if @root.editable}}
    <button type="button" class="build-open" data-action="openBuilder">
      <i class="fa-solid fa-list-check"></i> {{localize 'NOQUARTER.Builder.Open'}}
    </button>
    <button type="button" class="build-finish" data-action="finishBuild">
      <i class="fa-solid fa-check"></i> {{localize 'NOQUARTER.Build.Finish'}}
    </button>
    {{/if}}
  </div>
  {{/with}}
  {{/if}}
</header>
