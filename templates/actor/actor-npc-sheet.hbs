<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      <div class="resources npc-identity grid grid-4col">
        <div class="resource flex-group-center">
          <label for="system.level" class="resource-label">Level</label>
          <div class="resource-content flexrow flex-center">
            <input type="text" name="system.level" value="{{system.level}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.alignment" class="resource-label">Alignment</label>
          <input type="text" name="system.alignment" value="{{system.alignment}}" placeholder="Neutral"/>
        </div>

        <div class="resource flex-group-center">
          <label for="system.creatureType" class="resource-label">Creature type</label>
          <input type="text" name="system.creatureType" value="{{system.creatureType}}" placeholder="Humanoid"/>
        </div>

        {{!-- Monsters die at 0 health. Bosses can opt in to wounds. --}}
        <div class="resource flex-group-center">
          <label for="system.usesWounds" class="resource-label">Wounds</label>
          <div class="resource-content npc-wounds flexrow flex-center">
            <input type="checkbox" name="system.usesWounds" title="Uses wounds (bosses)" {{#if system.usesWounds}}checked{{/if}}/>
            {{#if system.usesWounds}}
              <input type="text" name="system.wounds" value="{{system.wounds}}" data-dtype="Number"/>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="abilities">Abilities</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Abilities Tab --}}
    <div class="tab abilities-tab" data-group="primary" data-tab="abilities">
      {{!-- The stat block: health, damage reduction and the success chances used by every ability. --}}
      <div class="resources npc-defenses grid grid-5col">
        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label">Health</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
            <span> / </span>
            <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.pdr" class="resource-label" title="Physical damage reduction">PDR</label>
          <div class="resource-content flexrow flex-center">
            <input type="text" name="system.pdr" value="{{system.pdr}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.mdr" class="resource-label" title="Magical damage reduction">MDR</label>
          <div class="resource-content flexrow flex-center">
            <input type="text" name="system.mdr" value="{{system.mdr}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.speed" class="resource-label">Speed</label>
          <div class="resource-content flexrow flex-center">
            {{!-- Restrained locks Speed at 0; the disabled box isn't submitted, so the base value survives. --}}
            {{#if system.restrained}}
            <input type="text" disabled="true" name="system.speed" value="{{system.effectiveSpeed}}" data-dtype="Number"
                   data-tooltip="{{ localize "EFFECT.StatusRestrained" }}"/>
            {{else}}
            <input type="text" name="system.speed" value="{{system.speed}}" data-dtype="Number"/>
            {{/if}}
          </div>
        </div>

        {{!-- The single set of success chances used by all of the monster's abilities. --}}
        <div class="resource flex-group-center">
          <label class="resource-label rollable" title="Roll a check" data-roll-type="stat">Stats</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.chances.regular" value="{{system.chances.regular}}" data-dtype="Number" title="Regular"/>
            <span> / </span>
            <input type="text" name="system.chances.greater" value="{{system.chances.greater}}" data-dtype="Number" title="Greater"/>
            <span> / </span>
            <input type="text" name="system.chances.extreme" value="{{system.chances.extreme}}" data-dtype="Number" title="Extreme"/>
          </div>
        </div>
      </div>

      {{> "systems/no-quarter/templates/actor/parts/actor-npc-abilities.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/no-quarter/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/no-quarter/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>

