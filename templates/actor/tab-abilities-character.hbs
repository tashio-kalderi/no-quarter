<section class="tab abilities-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <aside class="sidebar">
    <div class="stats-and-vitals flexrow">

      <div class="stats-column">
        <h3 class="stats-title">Stats</h3>
        <div class="stats flexcol">
          <div class="stats-header">
            <span>Name</span>
            <span>Rank</span>
            {{!-- Shares .stat-chances' layout with the rows below so the "/"s line up. --}}
            <div class="stat-chances">
              <span class="chance-label">Reg</span>
              <span>/</span>
              <span class="chance-label">Great</span>
              <span>/</span>
              <span class="chance-label">Ext</span>
            </div>
          </div>
          {{#each system.stats as |stat key|}}
          <div class="stat flexrow flex-group-center">
            <label for="system.stats.{{key}}.value" class="resource-label rollable flexlarge align-left" data-action="roll" data-roll-type="stat" data-stat="{{key}}" data-label="{{localize (lookup @root.config.stats key)}}">{{localize (lookup @root.config.stats key)}}</label>
            <input type="text" name="system.stats.{{key}}.value" value="{{stat.value}}" data-dtype="Number"/>
            <div class="stat-chances rollable" data-action="roll" data-roll-type="stat" data-stat="{{key}}" data-label="{{localize (lookup @root.config.stats key)}}">
              <input type="text" class="chance-box" value="{{stat.target.regular}}" readonly tabindex="-1"/>
              <span>/</span>
              <input type="text" class="chance-box" value="{{stat.target.greater}}" readonly tabindex="-1"/>
              <span>/</span>
              <input type="text" class="chance-box" value="{{stat.target.extreme}}" readonly tabindex="-1"/>
            </div>
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Vitals sit next to Stats. This mirrors the Stats column's structure (heading, then a
      blank header row) so the four rows below line up with the four stat rows. --}}
      <div class="vitals-column">
        <h3 class="stats-title">Vitals</h3>
        <div class="vitals flexcol">
          <div class="vitals-header">&nbsp;</div>

          <div class="vital flexrow flex-group-left">
            <label for="system.speed" class="resource-label align-left">Speed:</label>
            {{!-- Restrained locks Speed at 0; the disabled box isn't submitted, so the base value survives. --}}
            {{#if system.restrained}}
            <input type="text" disabled="true" name="system.speed" value="{{system.effectiveSpeed}}" data-dtype="Number"
                   data-tooltip="{{ localize "EFFECT.StatusRestrained" }}"/>
            {{else}}
            <input type="text" name="system.speed" value="{{system.speed}}" data-dtype="Number"/>
            {{/if}}
          </div>

          <div class="vital flexrow flex-group-left">
            <label for="system.wounds" class="resource-label align-left">Wounds:</label>
            <input type="text" name="system.wounds" value="{{system.wounds}}" data-dtype="Number"/>
          </div>

          <div class="vital flexrow flex-group-left">
            <label for="system.health.value" class="resource-label align-left">Health:</label>
            <div class="resource-content flexrow flex-center flex-between">
              <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
              <span> / </span>
              <input type="text" disabled="true" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
            </div>
          </div>

          <div class="vital flexrow flex-group-left">
            <label for="system.stamina.value" class="resource-label align-left">Stamina:</label>
            <div class="resource-content flexrow flex-center flex-between">
              <input type="text" name="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number"/>
              <span> / </span>
              <input type="text" disabled="true" name="system.stamina.max" value="{{system.stamina.max}}" data-dtype="Number"/>
            </div>
          </div>
        </div>
      </div>

    </div>
  </aside>

  {{!-- The abilities list sits below the stats. Its fields have no name: they belong to the
  ability items and are saved by the sheet's _onAbilityFieldChange. --}}
  <section class="main">
    <h3 class="abilities-title">Abilities</h3>
    <ol class="abilities-list">
      <li class="ability-row ability-header">
        <div>Name</div>
        <div>Stat</div>
        <div>Rank</div>
        {{!-- Shares .ability-chances' layout with the rows below so the "/"s line up. --}}
        <div class="ability-chances">
          <span class="chance-label">Reg</span>
          <span>/</span>
          <span class="chance-label">Great</span>
          <span>/</span>
          <span class="chance-label">Ext</span>
        </div>
        <div>Stam</div>
        <div>Effect/Notes</div>
        <div class="item-controls">
          <a class="item-control" data-action="createItem" data-type="ability"
             title="{{localize 'DOCUMENT.Create' type='ability'}}">
            <i class="fas fa-plus"></i>
            {{localize 'DOCUMENT.New' type='ability'}}
          </a>
        </div>
      </li>
      {{#each abilities as |item|}}
        <li class="item ability-row draggable" data-item-id="{{item._id}}">
          <div class="item-name">
            <a class="rollable" data-action="roll" data-roll-type="item">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </a>
            {{#if item.basic}}
              <h4>{{item.name}}</h4>
            {{else}}
              {{!-- Abilities other than the basic ones are filled in by hand. --}}
              <input type="text" class="ability-field ability-name" data-field="name" value="{{item.name}}"/>
            {{/if}}
          </div>
          {{#if item.basic}}
            <div class="ability-stat">{{localize (lookup @root.config.statAbbreviations item.system.stat)}}</div>
          {{else}}
            <div>
              <select class="ability-field ability-stat" data-field="stat">
                {{selectOptions @root.config.statAbbreviations selected=item.system.stat localize=true blank="-"}}
              </select>
            </div>
          {{/if}}
          <div>
            <input type="text" class="ability-field" data-field="rank" data-dtype="Number" data-nullable="true"
                   data-min="0" data-max="{{@root.config.successRules.maxRank}}" value="{{item.system.rank}}"/>
          </div>
          {{#if item.chances}}
            <div class="ability-chances rollable" data-action="roll" data-roll-type="item">
              {{!-- Styled like the read-only Health/Stamina max boxes: readonly (not disabled) so
              clicking still bubbles up to the rollable div above. --}}
              <input type="text" class="chance-box" value="{{item.chances.regular}}" readonly tabindex="-1"/>
              <span>/</span>
              <input type="text" class="chance-box" value="{{item.chances.greater}}" readonly tabindex="-1"/>
              <span>/</span>
              <input type="text" class="chance-box" value="{{item.chances.extreme}}" readonly tabindex="-1"/>
            </div>
          {{else}}
            {{!-- No stat means a passive ability: no success chance. --}}
            <div class="ability-passive">{{localize 'NOQUARTER.Passive'}}</div>
          {{/if}}
          <div>
            <input type="text" class="ability-field" data-field="staminaCost" data-dtype="Number" data-nullable="true"
                   data-min="0" value="{{item.system.staminaCost}}"/>
          </div>
          <div class="ability-effect">
            {{#if item.basic}}
              <span class="ability-damage-label">Damage (base 1)</span>
              <input type="text" class="ability-field ability-damage" data-field="damage" data-dtype="Number"
                     data-min="0" title="Damage" value="{{item.system.damage}}"/>
            {{else}}
              <input type="text" class="ability-field" data-field="effect" value="{{item.system.effect}}"/>
            {{/if}}
          </div>
          <div class="item-controls">
            <a class="item-control" data-action="editItem" title="{{localize 'DOCUMENT.Edit' type='ability'}}">
              <i class="fas fa-edit"></i>
            </a>
            {{#unless item.basic}}
              <a class="item-control" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='ability'}}">
                <i class="fas fa-trash"></i>
              </a>
            {{/unless}}
          </div>
        </li>
      {{/each}}
    </ol>
  </section>
</section>
