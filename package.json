{
  "name": "no-quarter",
  "version": "0.4.1",
  "description": "CSS compiler for the No Quarter system",
  "scripts": {
    "build": "sass src/scss/no-quarter.scss css/no-quarter.css --style=expanded --no-source-map",
    "watch": "sass src/scss/no-quarter.scss css/no-quarter.css --style=expanded --source-map --watch",
    "generate": "node src/generate-boilerplate-system.mjs",
    "pack": "node src/packs.mjs pack",
    "unpack": "node src/packs.mjs unpack"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Asacolips",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "glob": "^10.3.10",
    "inquirer": "^9.2.15",
    "prompt": "^1.3.0",
    "renamer": "^5.0.0",
    "replace": "^1.2.2",
    "sass": "^1.53.0"
  }
}
